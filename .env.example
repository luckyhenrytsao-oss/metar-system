.env.example

# ============================================================
# METAR 高频采集与分发系统 —— 环境变量模板
# 用法：复制本文件为 .env，填入真实值后启动容器。
#       cp .env.example .env
# ============================================================

# Redis 连接地址（Docker Compose 内网使用 redis://redis:6379/0）
REDIS_URL=redis://redis:6379/0

# 监控机场列表（逗号分隔 ICAO 代码）
# 默认已包含 M1 项目的 49 个机场，可按需覆盖：
MONITOR_AIRPORTS=ZSPD,ZBAA,EGLC,RKSI,WSSS,LFPB,KSEA,KATL,KORD,KLGA,RJTT,KDAL,ZUUU,ZUCK,ZGGG,ZGSZ,ZHHH,ZSQD,EPWA,WMKK,RCSS,LLBG,RKPK,LIMC,KMIA,NZWN,KBKF,RPLL,CYYZ,SBGR,EDDM,KLAX,KAUS,EHAM,SAEZ,KSFO,LTAC,LTFM,FACT,VILK,OPKC,MPMG,KHOU,MMMX,OEJN,EFHK,LEMD,VHHH,UUWW

# 采集轮询间隔（秒），必须在 1.0 ~ 2.0 之间
POLL_INTERVAL_SECONDS=1.0

# Redis 中 METAR 数据 TTL（秒），默认 7200（2 小时）
METAR_TTL_SECONDS=7200

# 请求头 User-Agent，必须包含可联系的邮箱，否则可能被数据源 403
# ⚠️ 请替换为你的真实邮箱
USER_AGENT=MyMetarApp/1.0 (htsao2000@gmail.com)

# weather.gov / SynopticData 独立 Token（可选但推荐生产使用）
# 未配置时会自动抓取 weather.gov 内嵌 Token，稳定性较低
# WEATHERGOV_TOKEN=your_synopticdata_token_here

# HTTP 请求超时（秒）
HTTP_TIMEOUT=15.0

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============================================================
# IEM LDM GTS 数据流配置（可选，仅在 VPS 上有效）
# ============================================================
# 是否启用 IEM LDM 采集；需要先在 VPS 上部署 m2-ldm 容器
IEM_LDM_ENABLED=false

# LDM 写入的 METAR 文件在 M2 容器内的路径（通常无需修改）
IEM_LDM_FILE_PATH=/app/ldm_data/metar/metars.txt

# METAR 文件截断清理间隔（小时），防止磁盘无限增长
IEM_LDM_TRUNCATE_INTERVAL_HOURS=1

# ============================================================
# Skyviewor fast-METAR WebSocket 数据源配置（可选，中国机场）
# ============================================================
# 是否启用 Skyviewor；未配置 API Key 时即使启用也不会启动
SKYVIEWOR_ENABLED=false

# Skyviewor 长期 API Key，用于换取临时 WebSocket Token
# SKYVIEWOR_API_KEY=sk-your-key-here

# 订阅的中国机场列表（通常无需修改）
# SKYVIEWOR_AIRPORTS=ZBAA,ZGGG,ZSPD,ZUCK,ZUUU,ZHHH,ZSQD

# 半点采信机场和 SPECI 采信机场（可按验证结果调整）
# SKYVIEWOR_TRUSTED_HALF_HOUR_AIRPORTS=ZBAA,ZGGG,ZSPD
# SKYVIEWOR_TRUSTED_SPECI_AIRPORTS=ZBAA,ZGGG

# ============================================================
# 延迟测量日志（T0TX-M2 latency measurement）
# ============================================================
M2_LATENCY_LOG_ENABLED=true
M2_LATENCY_LOG_PATH=/app/data/m2_latency.jsonl
# M2_LATENCY_LOG_MAX_BYTES=50000000
# M2_LATENCY_LOG_BACKUP_COUNT=3
